      ]
    },
    {
      "name": "redemptions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"redemptions\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"operation_id\" TEXT NOT NULL UNIQUE, \"reward_id\" TEXT NOT NULL REFERENCES rewards(id), \"title_snapshot\" TEXT NOT NULL, \"cost_snapshot\" INTEGER NOT NULL CHECK (typeof(cost_snapshot) = 'integer' AND cost_snapshot > 0), \"created_at\" INTEGER NOT NULL, \"canceled_at\" INTEGER);"
