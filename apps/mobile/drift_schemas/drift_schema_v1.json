          "sql": "CREATE INDEX records_point ON recycling_records (point_id)"
        }
      ]
    },
    {
      "name": "rewards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rewards\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"title\" TEXT NOT NULL, \"category\" TEXT NOT NULL CHECK (category IN ('photocopies', 'mobile', 'cafeteria')), \"cost_points\" INTEGER NOT NULL CHECK (typeof(cost_points) = 'integer' AND cost_points > 0), \"description\" TEXT NOT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (is_active IN (0, 1)));"
