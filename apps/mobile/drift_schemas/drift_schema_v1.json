    {
      "id": 8,
      "references": [
        5,
        1
      ],
      "type": "trigger",
      "data": {
        "on": 5,
        "references_in_body": [
          5,
          1
        ],
        "name": "protect_redemption_balance",
        "sql": "CREATE TRIGGER protect_redemption_balance\nBEFORE INSERT ON redemptions\nWHEN NEW.canceled_at IS NULL AND (\n  (SELECT coalesce(sum(quantity * unit_points), 0) FROM recycling_records) -\n  (SELECT coalesce(sum(cost_snapshot), 0) FROM redemptions WHERE canceled_at IS NULL)\n) < NEW.cost_snapshot\nBEGIN\n  SELECT RAISE(ABORT, 'insufficient_points');\nEND;"
      }
    },
    {
      "id": 9,
      "references": [
        1,
        5
      ],
      "type": "trigger",
      "data": {
        "on": 1,
        "references_in_body": [
          1,
          5
        ],
        "name": "protect_record_update_balance",
        "sql": "CREATE TRIGGER protect_record_update_balance\nBEFORE UPDATE ON recycling_records\nWHEN (\n  (SELECT coalesce(sum(quantity * unit_points), 0) FROM recycling_records)\n  - OLD.quantity * OLD.unit_points + NEW.quantity * NEW.unit_points\n) < (SELECT coalesce(sum(cost_snapshot), 0) FROM redemptions WHERE canceled_at IS NULL)\nBEGIN\n  SELECT RAISE(ABORT, 'committed_points');\nEND;"
      }
    },
    {
      "id": 10,
      "references": [
        1,
        5
      ],
      "type": "trigger",
      "data": {
        "on": 1,
        "references_in_body": [
          1,
          5
        ],
        "name": "protect_record_delete_balance",
        "sql": "CREATE TRIGGER protect_record_delete_balance\nBEFORE DELETE ON recycling_records\nWHEN (\n  SELECT coalesce(sum(quantity * unit_points), 0) FROM recycling_records WHERE id != OLD.id\n) < (SELECT coalesce(sum(cost_snapshot), 0) FROM redemptions WHERE canceled_at IS NULL)\nBEGIN\n  SELECT RAISE(ABORT, 'committed_points');\nEND;"
      }
    },
    {
      "id": 11,
      "references": [
        5
      ],
      "type": "trigger",
      "data": {
        "on": 5,
        "references_in_body": [
          5
        ],
        "name": "immutable_redemption",
        "sql": "CREATE TRIGGER immutable_redemption\nBEFORE UPDATE ON redemptions\nWHEN NEW.id != OLD.id OR NEW.operation_id != OLD.operation_id OR\n  NEW.reward_id != OLD.reward_id OR NEW.title_snapshot != OLD.title_snapshot OR\n  NEW.cost_snapshot != OLD.cost_snapshot OR NEW.created_at != OLD.created_at OR\n  (OLD.canceled_at IS NOT NULL AND NEW.canceled_at IS NOT OLD.canceled_at)\nBEGIN\n  SELECT RAISE(ABORT, 'immutable_redemption');\nEND;"
      }
    }
