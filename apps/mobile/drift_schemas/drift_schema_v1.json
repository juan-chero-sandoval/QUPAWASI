    {
      "name": "recycling_points",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recycling_points\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"name\" TEXT NOT NULL CHECK (length(trim(name)) > 0), \"description\" TEXT NOT NULL, \"occupancy\" INTEGER NOT NULL CHECK (typeof(occupancy) = 'integer' AND occupancy BETWEEN 0 AND 100), \"latitude\" REAL, \"longitude\" REAL, \"is_demo\" INTEGER NOT NULL DEFAULT 1 CHECK (is_demo IN (0, 1)));"
        }
      ]
    },
    {
      "name": "recycling_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recycling_records\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"point_id\" TEXT NOT NULL REFERENCES recycling_points(id), \"material\" TEXT NOT NULL CHECK (material IN ('pet', 'aluminum')), \"quantity\" INTEGER NOT NULL CHECK (typeof(quantity) = 'integer' AND quantity BETWEEN 1 AND 100), \"unit_points\" INTEGER NOT NULL CHECK (typeof(unit_points) = 'integer' AND unit_points > 0), \"occurred_at\" INTEGER NOT NULL, \"note\" TEXT NOT NULL DEFAULT '' CHECK (length(note) <= 200), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "records_occurred_at",
      "sql": [
        {
          "dialect": "sqlite",
